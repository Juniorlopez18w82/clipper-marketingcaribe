# Copia a .env y ajusta si hace falta. No hay claves obligatorias.
# Sin API de YouTube: yt-dlp lee el link directamente.
CLIPPER_WHISPER_MODEL=base
# tiny = rápido / base = recomendado / small = más preciso y lento en CPU
CLIPPER_WHISPER_DEVICE=cpu
CLIPPER_WHISPER_COMPUTE=int8
CLIPPER_MAX_WORKERS=2
# Puerto local
# PORT=8000
